# Copy this file to ".env" and fill in your values locally.
# The ".env" file is gitignored — never commit real credentials.

# Database (local development)
DB_URL=jdbc:mysql://localhost:3306/clinic_db
DB_USERNAME=
DB_PASSWORD=

# Brevo transactional email
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=KurePulse Clinic
OTP_EXPIRY_MINUTES=10

# Doctor and staff login credentials
DOCTOR_USERNAME=
DOCTOR_PASSWORD=
STAFF_USERNAME=
STAFF_PASSWORD=

# Comma-separated exact frontend origins allowed by CORS (local dev)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional Vercel URL patterns for preview/production deployments
# CORS_ALLOWED_ORIGIN_PATTERNS=https://*-saifus-projects-4f77054e.vercel.app,https://d-portal-*.vercel.app

# Optional upload directory override
# APP_UPLOAD_DIR=uploads/reports
