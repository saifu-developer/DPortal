# Copy this file to ".env" and fill in your values locally.
# The ".env" file is gitignored — never commit real credentials.

# Database (local development)
DB_URL=jdbc:mysql://localhost:3306/clinic_db
DB_USERNAME=
DB_PASSWORD=

# Required — clinic Gmail address and App Password
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional — defaults shown below
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_FROM=
MAIL_FROM_NAME=KurePulse Clinic
OTP_EXPIRY_MINUTES=10

# Doctor and staff login credentials
DOCTOR_USERNAME=
DOCTOR_PASSWORD=
STAFF_USERNAME=
STAFF_PASSWORD=

# Comma-separated exact frontend origins allowed by CORS (local dev)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional Vercel URL patterns for preview/production deployments
# CORS_ALLOWED_ORIGIN_PATTERNS=https://*-saifus-projects-4f77054e.vercel.app,https://d-portal-*.vercel.app

# Optional upload directory override
# APP_UPLOAD_DIR=uploads/reports

# Gmail App Password setup:
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Create App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character App Password as MAIL_PASSWORD
# 4. Leave MAIL_FROM empty to use MAIL_USERNAME as the sender address
